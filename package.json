{
  "name": "ScrapSys",
  "version": "1.2.7",
  "description": "Sistema de Gestão Industrial para Ferro-Velho",
  "main": "./out/main/index.js",
  "author": "Alisson Rodrigues",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "mobile:dev": "vite --config vite.mobile.config.mjs --host 0.0.0.0",
    "mobile:build": "vite build --config vite.mobile.config.mjs",
    "android:add": "pnpm mobile:build && cap add android",
    "android:sync": "pnpm mobile:build && cap sync android",
    "android:open": "pnpm android:sync && cap open android",
    "android:run": "pnpm android:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.3.9",
    "firebase": "^12.15.0",
    "lucide-react": "^1.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.14",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.19",
    "vite": "^7.2.6"
  },
  "build": {
    "appId": "com.scrapsys.industrial",
    "productName": "ScrapSys",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "fiore123",
        "repo": "scrapsys-app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "artifactName": "ScrapSys-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ]
  }
}
